# Proaktiver Alltags-Copilot — Beispiel-Konfiguration
# Kopiere diese Datei nach `.env` und fülle die Werte aus.
# Die echte `.env` wird NICHT eingecheckt (siehe .gitignore).

# --- App ---
APP_NAME="Proaktiver Alltags-Copilot"
DEBUG=true

# --- Datenbank ---
# SQLite im MVP. Später z.B. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL="sqlite:///./copilot.db"

# --- Anthropic Claude API (Schritt 5: Das "Gehirn") ---
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-20250514"

# --- Telegram Bot (Schritt 2) ---
TELEGRAM_BOT_TOKEN=""

# --- Google Calendar (Schritt 4: read-only Sync) ---
# OAuth-Client-Zugangsdaten aus der Google Cloud Console (OAuth 2.0 Client-ID,
# Typ "Desktop App"). NUR hier eintragen, niemals in den Code.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Welcher Kalender gelesen wird ("primary" = Hauptkalender).
GOOGLE_CALENDAR_ID="primary"
# Pfad, in dem das OAuth-Token gespeichert wird (wird gitignored).
GOOGLE_TOKEN_FILE="token.json"

# --- Standard-Zeitzone des Nutzers ---
DEFAULT_TIMEZONE="Europe/Berlin"
